{
  "version": 2,
  "crons": [
    {
      "path": "/api/broker/cron/expire-transactions",
      "schedule": "0 * * * *"
    }
  ],
  "builds": [
    {
      "src": "engine/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "engine/wsgi.py"
    }
  ]
}
